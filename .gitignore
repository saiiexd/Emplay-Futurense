# Environment variables - never commit real credentials
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Generated data
#
# data/input/ holds the supplied assignment corpus and IS tracked, so a
# reviewer can reproduce the run from a clean checkout.
# data/output/ is generated; only the assignment-facing deliverables and their
# audit trails are tracked (see the negations below).
data/cache/
.embeddings_cache/

data/output/*
!data/output/.gitkeep
!data/output/extracted_data.json
!data/output/*.flat.json
!data/output/*.diagnostics.json

# Test / tooling artifacts
.pytest_cache/
.coverage
htmlcov/
tests/tmp_out/
