# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed. This template holds
# placeholders only - never put a real key here.

# Which provider the extraction engine uses. Exactly one of:
#   openrouter  (default, active)
#   openai
#   mistral
# The selected provider validates only its own credentials: choosing
# openrouter never requires an OpenAI or Mistral key, and vice versa.
LLM_PROVIDER=openrouter

# --- OpenRouter (active provider) -------------------------------------------
# OpenAI-compatible API. Free models are available; the default below is one.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACTION_MODEL=qwen/qwen3-30b-a3b:free

# --- OpenAI (optional alternative) ------------------------------------------
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EXTRACTION_MODEL=gpt-4o

# --- Native Mistral (optional alternative) ----------------------------------
# Only needed when LLM_PROVIDER=mistral. Uses the mistralai SDK directly.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EXTRACTION_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai

# Configuration
LOG_LEVEL=INFO
