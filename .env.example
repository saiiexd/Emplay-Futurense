# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed. This template holds
# placeholders only - never put a real key here.

# Which provider the extraction engine uses.
LLM_PROVIDER=gemini

# --- Google Gemini -------------------------------------------
# Fast and cost-effective extraction model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EXTRACTION_MODEL=models/gemini-flash-latest

# Configuration
LOG_LEVEL=INFO
